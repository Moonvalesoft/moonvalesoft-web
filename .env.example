# Kopyala: cp .env.example .env  (.env depoya girmez)
# Uygulama mv_api ile bağlanır (süper kullanıcı değil, tablo sahibi değil). Migration ayrı kullanıcıyla:
DATABASE_URL=postgres://mv_api:mv_api_dev@localhost:5432/moonvale_web
MIGRATION_DATABASE_URL=postgres://mv_migrator:mv_migrator_dev@localhost:5432/moonvale_web
# Yalnız geliştirmede: API açılırken migration'ı da çalıştır (üretimde ayrı adım: npm run migrate).
MIGRATE_ON_START=true
# X-Forwarded-For'a güvenilecek vekil adresleri (Caddy, Next). Üretimde zorunlu.
TRUSTED_PROXIES=127.0.0.1,::1
WEB_ORIGIN=http://localhost:3000
API_PORT=4000
SESSION_SECURE=false
# Fiyatlar kuruş cinsinden. Boş bırakılan plan satışa kapalı görünür.
PLAN_PRICES=
# Ödeme: şimdilik sadece "fake" (test sağlayıcısı). Gerçek sağlayıcı en son seçilecek.
PAYMENT_PROVIDER=fake
PAYMENT_WEBHOOK_SECRET=degistir-bunu
# Test ödeme sayfası (/test-odeme) ve ucu. Yalnız geliştirmede, açıkça açılır; üretimde her durumda kapalı.
DEV_FAKE_PAYMENTS=true
NEXT_PUBLIC_DEV_FAKE_PAYMENTS=true
# E-posta (geliştirmede Mailpit: http://localhost:8025)
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Moonvalesoft <merhaba@moonvalesoft.com>
ADMIN_EMAIL=
# Randevu firma kurulumu
RANDEVU_API_URL=
RANDEVU_API_KEY=
